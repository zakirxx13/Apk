<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="@color/glass_nav_start" android:endColor="@color/glass_nav_end" android:angle="270.0" android:type="linear" android:centerColor="@color/glass_nav_center" />
            <solid android:color="@color/drawer_glass_solid" />
        </shape>
    </item>
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <size android:height="1.0dp" />
            <solid android:color="@color/glass_stroke" />
        </shape>
    </item>
</layer-list>
