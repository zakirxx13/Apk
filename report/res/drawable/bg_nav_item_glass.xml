<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="@color/glass_nav_start" android:endColor="@color/glass_nav_end" android:angle="270.0" android:type="linear" android:centerColor="@color/glass_nav_center" />
            <solid android:color="@color/glass_nav_solid" />
            <stroke android:width="1.0dp" android:color="@color/glass_stroke" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="@color/glass_nav_start" android:endColor="@color/glass_nav_end" android:angle="270.0" android:type="linear" android:centerColor="@color/glass_nav_center" />
            <solid android:color="@color/glass_nav_solid" />
            <stroke android:width="1.0dp" android:color="@color/glass_stroke" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
</selector>
