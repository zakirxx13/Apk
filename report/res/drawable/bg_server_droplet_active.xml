<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999.0dp" />
            <solid android:color="@color/server_droplet_base_active" />
        </shape>
    </item>
    <item android:left="1.0dp" android:top="1.0dp" android:right="1.0dp" android:bottom="1.0dp">
        <shape android:shape="rectangle">
            <corners android:radius="999.0dp" />
            <gradient android:startColor="@color/server_droplet_highlight_start" android:endColor="@color/server_droplet_highlight_end" android:angle="135.0" android:centerColor="@color/server_droplet_highlight_center" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999.0dp" />
            <stroke android:width="1.0dp" android:color="@color/server_droplet_stroke_active" />
        </shape>
    </item>
</layer-list>
