<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/track_row_odd_focus" />
            <stroke android:width="1.0dp" android:color="@color/track_row_focus_stroke" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/track_row_odd_selected" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/track_row_odd_focus" />
            <stroke android:width="1.0dp" android:color="@color/track_row_focus_stroke" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/track_row_odd" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
</selector>
