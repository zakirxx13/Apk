<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#8020334a" />
            <corners android:radius="20.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#55ffffff" android:endColor="#00ffffff" android:angle="135.0" android:type="linear" android:centerColor="#1affffff" />
            <corners android:radius="20.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="2.0dp" android:color="@color/primary_color" />
            <corners android:radius="20.0dp" />
        </shape>
    </item>
</layer-list>
