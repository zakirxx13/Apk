            <gradient android:startColor="#221ccbd4" android:endColor="#08ffffff" android:angle="0.0" android:type="linear" />
            <stroke android:width="1.0dp" android:color="@color/primary_color" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
    <item android:gravity="start" android:width="4.0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_color" />
            <corners android:topLeftRadius="12.0dp" android:bottomLeftRadius="12.0dp" />
        </shape>
    </item>
</layer-list>
