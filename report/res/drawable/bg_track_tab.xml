<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/track_tab_bg_focused" />
            <stroke android:width="1.0dp" android:color="@color/primary_color" />
            <corners android:radius="999.0dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/track_tab_bg_selected" />
            <stroke android:width="1.0dp" android:color="@color/primary_color" />
            <corners android:radius="999.0dp" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/track_tab_bg_selected" />
            <stroke android:width="1.0dp" android:color="@color/primary_color" />
            <corners android:radius="999.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/track_tab_bg_default" />
            <corners android:radius="999.0dp" />
        </shape>
    </item>
</selector>
