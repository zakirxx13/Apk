<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#a6101726" />
            <corners android:radius="14.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#2effffff" android:endColor="#00ffffff" android:angle="270.0" android:type="linear" android:centerColor="#14ffffff" />
            <corners android:radius="14.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1.0dp" android:color="#42ffffff" />
            <corners android:radius="14.0dp" />
        </shape>
    </item>
</layer-list>
