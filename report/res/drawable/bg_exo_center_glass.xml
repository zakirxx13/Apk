<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#66101826" />
            <corners android:radius="26.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#28ffffff" android:endColor="#00ffffff" android:angle="135.0" android:type="linear" android:centerColor="#10ffffff" />
            <corners android:radius="26.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1.0dp" android:color="#33ffffff" />
            <corners android:radius="26.0dp" />
        </shape>
    </item>
</layer-list>
